<odoo>

    <record id="view_pos_prep_order_list" model="ir.ui.view">
        <field name="name">pos.prep.order.list</field>
        <field name="model">pos.prep.order</field>
        <field name="arch" type="xml">
            <list string="Kitchen Order History" default_order="create_date desc">
                <field name="create_date" string="Received"/>
                <field name="pos_order_id"/>
                <field name="display_id"/>
                <field name="table_number"/>
                <field name="fulfillment_type"/>
                <field name="stage_id"/>
                <field name="done_date"/>
                <field name="prep_duration" avg="1" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_pos_prep_order_pivot" model="ir.ui.view">
        <field name="name">pos.prep.order.pivot</field>
        <field name="model">pos.prep.order</field>
        <field name="arch" type="xml">
            <pivot string="Average Prep Time">
                <field name="display_id" type="row"/>
                <field name="fulfillment_type" type="col"/>
                <field name="prep_duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_prep_order_graph" model="ir.ui.view">
        <field name="name">pos.prep.order.graph</field>
        <field name="model">pos.prep.order</field>
        <field name="arch" type="xml">
            <graph string="Average Prep Time" type="bar">
                <field name="display_id"/>
                <field name="prep_duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pos_prep_order_history" model="ir.actions.act_window">
        <field name="name">Kitchen Order History</field>
        <field name="res_model">pos.prep.order</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

</odoo>
