<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Payslip Form to add input_type_id in input_line_ids -->
    <record id="hr_payslip_view_form_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.hudson.core</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='input_line_ids']//list//field[@name='name']" position="before">
                <field name="input_type_id" domain="['|', ('effective_struct_ids', '=', False), ('effective_struct_ids', '=', parent.struct_id)]"/>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']//form//field[@name='name']" position="before">
                <field name="input_type_id" domain="['|', ('effective_struct_ids', '=', False), ('effective_struct_ids', '=', parent.struct_id)]"/>
            </xpath>
            <!-- Form View Nested List Column Toggles -->
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='category_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='sequence']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='quantity']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='rate']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='amount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='salary_rule_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/*[self::tree or self::list]/field[@name='number_of_hours']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/*[self::tree or self::list]/field[@name='contract_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/*[self::tree or self::list]/field[@name='contract_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Main Payslips List View Optional Column Toggles -->
    <record id="hr_payslip_view_tree_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.payslip.view.list.inherit.hudson.core</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_from']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Payslip Batches List View Optional Column Toggles -->
    <record id="hr_payslip_run_view_tree_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.list.inherit.hudson.core</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='credit_note']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
