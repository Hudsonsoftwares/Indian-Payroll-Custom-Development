<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Salary Structure form view to add Type and Other Inputs tab -->
    <record id="hr_payroll_structure_view_form_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.payroll.structure.view.form.inherit.hudson.core</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payroll_structure_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="type_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Other Inputs" name="other_inputs">
                    <field name="input_type_ids">
                        <list editable="bottom">
                            <field name="name" string="Description"/>
                            <field name="code" optional="show"/>
                            <field name="input_section_id" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Salary Structures List View Optional Column Toggles -->
    <record id="hr_payroll_structure_view_tree_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.payroll.structure.view.list.inherit.hudson.core</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payroll_structure_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
