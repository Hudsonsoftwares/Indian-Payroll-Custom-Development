<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Contract/Version Form View to add structure_type_id -->
    <record id="hr_contract_template_form_view_inherit_hudson_core" model="ir.ui.view">
        <field name="name">hr.version.view.form.inherit.hudson.core</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='struct_id']" position="before">
                <field name="country_code" invisible="1"/>
                <field name="company_country_code" invisible="1"/>
                <field name="is_india_localization" invisible="1"/>
                <field name="is_uae_localization" invisible="1"/>
                <field name="structure_type_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
