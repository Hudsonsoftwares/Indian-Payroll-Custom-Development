<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_salary_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">hr.salary.adjustment.wizard.form</field>
        <field name="model">hr.salary.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="New Group Sal. Adjustment">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select employees..."/>
                            <field name="input_type_id" options="{'no_create': True}"/>
                            <label for="amount"/>
                            <div class="o_row">
                                <field name="amount"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                            <field name="negative"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="date_start"/>
                            <field name="date_end" invisible="duration != 'limited'" required="duration == 'limited'"/>
                            <field name="until_amount" invisible="duration != 'limited'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Short description or note..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_adjustments" string="Create Adjustments" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_salary_adjustment_wizard" model="ir.actions.act_window">
        <field name="name">New Group Sal. Adjustment</field>
        <field name="res_model">hr.salary.adjustment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
