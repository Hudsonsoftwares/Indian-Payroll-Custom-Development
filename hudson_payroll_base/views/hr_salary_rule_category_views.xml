<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category Form View -->
        <record id="hr_salary_rule_category_view_form" model="ir.ui.view">
            <field name="name">hr.salary.rule.category.form</field>
            <field name="model">hr.salary.rule.category</field>
            <field name="arch" type="xml">
                <form string="Salary Rule Category">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="notes" string="Notes">
                                <field name="note" placeholder="Write description or notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Category List View -->
        <record id="hr_salary_rule_category_view_list" model="ir.ui.view">
            <field name="name">hr.salary.rule.category.list</field>
            <field name="model">hr.salary.rule.category</field>
            <field name="arch" type="xml">
                <list string="Salary Rule Categories">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="parent_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Category Action -->
        <record id="action_hr_salary_rule_category" model="ir.actions.act_window">
            <field name="name">Salary Rule Categories</field>
            <field name="res_model">hr.salary.rule.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Salary Rule Category
                </p>
                <p>
                    Categories group salary rules and calculate totals (e.g. Basic, Gross, Deductions, Net).
                </p>
            </field>
        </record>
    </data>
</odoo>
