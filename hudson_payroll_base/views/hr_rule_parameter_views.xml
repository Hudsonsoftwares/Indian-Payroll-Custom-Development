<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rule_parameter_view_form" model="ir.ui.view">
            <field name="name">hr.rule.parameter.form</field>
            <field name="model">hr.rule.parameter</field>
            <field name="arch" type="xml">
                <form string="Rule Parameter">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="e.g. Provident Fund Statutory Wage Ceiling"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="versions" string="Values by Effective Date">
                                <field name="parameter_version_ids">
                                    <list editable="bottom">
                                        <field name="date_from"/>
                                        <field name="parameter_value"/>
                                    </list>
                                </field>
                            </page>
                            <page name="description" string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_rule_parameter_view_list" model="ir.ui.view">
            <field name="name">hr.rule.parameter.list</field>
            <field name="model">hr.rule.parameter</field>
            <field name="arch" type="xml">
                <list string="Rule Parameters">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="country_id"/>
                </list>
            </field>
        </record>

        <record id="action_hr_rule_parameter" model="ir.actions.act_window">
            <field name="name">Rule Parameters</field>
            <field name="res_model">hr.rule.parameter</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
