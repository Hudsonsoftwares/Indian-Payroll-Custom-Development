<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_type_view_form" model="ir.ui.view">
        <field name="name">hr.employee.type.form</field>
        <field name="model">hr.employee.type</field>
        <field name="arch" type="xml">
            <form string="Employee Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_type_view_list" model="ir.ui.view">
        <field name="name">hr.employee.type.list</field>
        <field name="model">hr.employee.type</field>
        <field name="arch" type="xml">
            <list string="Employee Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_employee_type" model="ir.actions.act_window">
        <field name="name">Employee Types</field>
        <field name="res_model">hr.employee.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Employees App > Configuration > Employee Types -->
    <menuitem id="menu_action_hr_employee_type"
              name="Employee Types"
              parent="hr.menu_config_employee"
              action="action_hr_employee_type"
              sequence="8"/>

    <!-- Inherit Employee Form to show Employee Type and remove Contract Type -->
    <record id="hr_employee_view_form_inherit_hds_type" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hds.type</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="bank_account_id"/>
            </xpath>
            <xpath expr="//field[@name='employee_type']" position="replace">
                <field name="employee_type" invisible="1"/>
                <field name="employee_type_id" string="Employee Type" placeholder="Employee Type" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
