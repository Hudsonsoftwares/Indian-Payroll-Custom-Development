<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Payslip Form View -->
        <record id="hr_payslip_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <form string="Salary Slip">
                    <header>
                        <button string="Compute Sheet" name="compute_sheet" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button string="Validate" name="action_payslip_done" type="object" class="btn-primary" invisible="state not in ('draft', 'verify')"/>
                        <button string="Pay" name="action_open_pay_wizard" type="object" class="btn-primary" invisible="state != 'done'"/>
                        <button string="Send By Email" name="action_payslip_send_email" type="object" class="btn-secondary" invisible="state not in ('done', 'paid')"/>
                        <button string="Print" name="action_print_payslip" type="object" class="btn-secondary"/>
                        <button string="Cancel" name="action_payslip_cancel" type="object" invisible="state in ('draft', 'cancel')"/>
                        <button string="Refund" name="refund_sheet" type="object" invisible="state != 'done'"/>
                        <button string="Set to Draft" name="action_payslip_draft" type="object" invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,paid"/>
                    </header>

                    <!-- Alert Ribbon: No Running Contract -->
                    <div class="alert alert-danger mb-0 border-0 rounded-0 d-flex align-items-center py-2 px-3" role="alert" invisible="not employee_id or not has_no_running_contract" style="background-color: rgba(220, 53, 69, 0.2); border-left: 4px solid #dc3545 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-danger fw-semibold">No running contract</span>
                            <i class="fa fa-arrow-right text-muted"/>
                            <button name="action_open_contract" type="object" string="Contract" class="oe_link p-0 align-baseline fw-bold text-info"/>
                        </div>
                    </div>

                    <!-- Alert Ribbon: Zero or Negative Net Pay -->
                    <div class="alert alert-warning mb-0 border-0 rounded-0 d-flex align-items-center py-2 px-3" role="alert" invisible="not employee_id or not has_zero_or_negative_net" style="background-color: rgba(255, 193, 7, 0.2); border-left: 4px solid #ffc107 !important;">
                        <span class="text-warning fw-semibold">The net pay for this payslip is zero or negative.</span>
                    </div>

                    <!-- Warning Ribbon: Missing Bank Account -->
                    <div class="alert alert-warning mb-0 border-0 rounded-0 d-flex align-items-center py-2 px-3" role="alert" invisible="not employee_id or has_bank_account" style="background-color: rgba(255, 193, 7, 0.15); border-left: 4px solid #ffc107 !important;">
                        <i class="fa fa-exclamation-triangle me-2 text-warning fs-5"/>
                        <div class="d-flex align-items-center gap-1">
                            <span>No bank account</span>
                            <i class="fa fa-arrow-right mx-1 text-muted"/>
                            <field name="employee_id" widget="res_partner_many2one" readonly="1" options="{'no_open': False}" class="fw-bold text-decoration-underline"/>
                        </div>
                    </div>

                    <sheet>
                        <field name="has_no_running_contract" invisible="1"/>
                        <field name="has_zero_or_negative_net" invisible="1"/>
                        <field name="has_bank_account" invisible="1"/>
                        <field name="effective_advice_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_payment_advice"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-university"
                                    invisible="not effective_advice_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Payment</span>
                                    <span class="o_stat_text">Advice</span>
                                </div>
                            </button>
                        </div>

                        <!-- Hero Section: Employee Profile & KPI Stats -->
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <!-- Left: Avatar & Identity -->
                            <div class="d-flex align-items-start">
                                <field name="employee_avatar" widget="image" class="oe_avatar me-3 rounded" options="{'size': [88, 88]}" style="width: 88px; height: 88px; object-fit: cover;"/>
                                <div>
                                    <h1 class="mb-1">
                                        <field name="employee_id" placeholder="Employee" options="{'no_create': True}" class="fw-bold" style="font-size: 2.2rem; color: #00b4d8;"/>
                                    </h1>
                                    <div class="mb-3">
                                        <field name="struct_id" placeholder="Regular Pay" class="text-info fw-bold" options="{'no_open': True}"/>
                                    </div>
                                    <div class="d-flex flex-column gap-2" style="font-size: 0.95rem;">
                                        <div class="d-flex align-items-center">
                                            <span class="text-muted fw-semibold me-3" style="min-width: 75px;">Pay Run</span>
                                            <field name="payslip_run_id" placeholder="e.g. Jul 2026" class="fw-semibold"/>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <span class="text-muted fw-semibold me-3" style="min-width: 75px;">Period</span>
                                            <div class="d-flex align-items-center fw-semibold">
                                                <field name="date_from" class="me-2"/>
                                                <i class="fa fa-arrow-right text-muted me-2"/>
                                                <field name="date_to"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Modern KPI Stat Widgets -->
                            <div class="d-flex gap-3 mt-1">
                                <!-- Card 1: Worked days -->
                                <div class="card p-3 shadow-sm border-0 text-center" style="min-width: 160px; background: rgba(128,128,128,0.08); border-radius: 8px;">
                                    <div class="text-muted small fw-bold text-uppercase">Worked days</div>
                                    <div class="fs-4 my-1 fw-bold"><field name="total_worked_days"/> days</div>
                                    <div class="text-muted small"><field name="total_worked_hours"/>h / <field name="attendance_expected_hours"/>h (<field name="total_scheduled_days"/> d)</div>
                                </div>
                                <!-- Card 2: Net Wage -->
                                <div class="card p-3 shadow-sm border-0 text-center" style="min-width: 160px; background: rgba(128,128,128,0.08); border-radius: 8px;">
                                    <div class="text-muted small fw-bold text-uppercase">Net Wage</div>
                                    <div class="fs-4 my-1 fw-bold"><field name="net_wage" widget="monetary"/></div>
                                    <div class="text-muted small">Gross: <field name="gross_wage" widget="monetary"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Notebook Tabs (Matching Enterprise structure) -->
                        <notebook>
                            <!-- Tab 1: Worked Days -->
                            <page name="worked_days" string="Worked Days">
                                <field name="worked_days_line_ids">
                                    <list create="false" editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" string="Type"/>
                                        <field name="contract_id" string="Contract"/>
                                        <field name="description" string="Description"/>
                                        <field name="code" optional="hide"/>
                                        <field name="number_of_days" string="Days"/>
                                        <field name="number_of_hours" string="Hours"/>
                                        <field name="amount" string="Amount" widget="monetary"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Tab 2: Salary Inputs -->
                            <page name="salary_inputs" string="Salary Inputs">
                                <field name="input_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="input_type_id" string="Description" required="1"/>
                                        <field name="code" readonly="1" force_save="1"/>
                                        <field name="amount" string="Amount" widget="monetary"/>
                                        <field name="adjustment_id" string="Salary Adjustment" optional="show" readonly="1"/>
                                        <field name="name" string="Note" optional="hide"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Tab 3: Salary Computation -->
                            <page name="salary_computation" string="Salary Computation">
                                <field name="line_ids">
                                    <list string="Salary Computation" decoration-info="total &gt; 0">
                                        <field name="sequence" widget="handle"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="rate"/>
                                        <field name="amount"/>
                                        <field name="quantity"/>
                                        <field name="total"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="gross_wage" widget="monetary"/>
                                    <field name="net_wage" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                            </page>

                            <!-- Tab 4: Other Info -->
                            <page name="other_info" string="Other Info">
                                <group>
                                    <group>
                                        <field name="name" string="Title"/>
                                        <field name="no_worked_days"/>
                                        <field name="note" string="Note" placeholder="Add a note on the printed payslip."/>
                                        <field name="contract_id" invisible="1"/>
                                        <field name="credit_note" invisible="1"/>
                                        <field name="has_bank_account" invisible="1"/>
                                        <field name="bank_account_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="payment_date" string="Payment Date"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="number" invisible="1"/>
                                        <field name="paid" invisible="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Payslip List View -->
        <record id="hr_payslip_view_list" model="ir.ui.view">
            <field name="name">hr.payslip.list</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <list string="Employee Payslips">
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="payslip_warning" string="Warnings" widget="badge" decoration-warning="payslip_warning" optional="show"/>
                    <field name="total_worked_days" string="Worked Days" optional="show"/>
                    <field name="basic_wage" string="Basic Wage" widget="monetary" sum="Total Basic Wage" optional="show"/>
                    <field name="net_wage" string="Net Wage" widget="monetary" sum="Total Net Wage" optional="show"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'verify'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
                    <button name="action_detach_off_cycle"
                            type="object"
                            string="→ Off-Cycle"
                            class="btn btn-link text-info fw-semibold p-0 btn-off-cycle"
                            title="Off-Cycle&#10;Detach the payslip from the pay run to send it to the Off-Cycle"
                            invisible="not payslip_run_id"/>
                    <field name="payslip_run_id" optional="hide"/>
                    <field name="number" optional="hide"/>
                    <field name="name" optional="hide"/>
                    <field name="date_from" optional="hide"/>
                    <field name="date_to" optional="hide"/>
                    <field name="struct_id" optional="hide"/>
                    <field name="gross_wage" widget="monetary" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Payslip Search View -->
        <record id="hr_payslip_view_search" model="ir.ui.view">
            <field name="name">hr.payslip.search</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <search string="Search Payslips">
                    <field name="name" string="Payslip" filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                    <field name="employee_id"/>
                    <field name="payslip_run_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <group>
                        <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Batch" name="batch" context="{'group_by': 'payslip_run_id'}"/>
                        <filter string="Status" name="state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payslip Action -->
        <record id="action_hr_payslip" model="ir.actions.act_window">
            <field name="name">Employee Payslips</field>
            <field name="res_model">hr.payslip</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="hr_payslip_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Salary Slip
                </p>
            </field>
        </record>
    </data>
</odoo>
