<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Core Rule Categories -->
        <record id="rule_category_basic" model="hr.salary.rule.category">
            <field name="name">Basic</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
        </record>

        <record id="rule_category_alw" model="hr.salary.rule.category">
            <field name="name">Allowance</field>
            <field name="code">ALW</field>
            <field name="sequence">2</field>
        </record>

        <record id="rule_category_gross" model="hr.salary.rule.category">
            <field name="name">Taxable Salary</field>
            <field name="code">GROSS</field>
            <field name="sequence">10</field>
        </record>

        <record id="rule_category_ded" model="hr.salary.rule.category">
            <field name="name">Deduction</field>
            <field name="code">DED</field>
            <field name="sequence">20</field>
        </record>

        <record id="rule_category_net" model="hr.salary.rule.category">
            <field name="name">Net</field>
            <field name="code">NET</field>
            <field name="sequence">100</field>
        </record>

        <record id="rule_category_comp" model="hr.salary.rule.category">
            <field name="name">Company Contribution</field>
            <field name="code">COMP</field>
            <field name="sequence">200</field>
        </record>
    </data>
</odoo>
