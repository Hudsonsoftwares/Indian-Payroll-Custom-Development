<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.account</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button for Accounting Entry -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_account_move"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="not move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Accounting</span>
                        <span class="o_stat_text">Entry</span>
                    </div>
                </button>
            </xpath>

            <!-- Accounting Fields under Other Info Tab -->
            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="journal_id" required="1" readonly="state != 'draft'" options="{'no_create': True}"/>
                <field name="move_id" readonly="1" invisible="not move_id"/>
                <field name="date" string="Accounting Date" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
