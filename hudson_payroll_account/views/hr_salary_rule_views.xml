<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_view_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit.account</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_salary_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="accounting" string="Accounting">
                    <group>
                        <group string="Accounts">
                            <field name="account_debit_id" options="{'no_create': True}"/>
                            <field name="account_credit_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Analytic &amp; Taxes">
                            <field name="analytic_account_id" groups="analytic.group_analytic_accounting" options="{'no_create': True}"/>
                            <field name="account_tax_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
