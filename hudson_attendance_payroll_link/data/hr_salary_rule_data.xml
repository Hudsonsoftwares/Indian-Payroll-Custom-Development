<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Overtime Pay Salary Rule — Standard Odoo 19 Overtime Rulesets Integration -->
        <record id="hr_rule_overtime_pay" model="hr.salary.rule">
            <field name="name">Overtime Pay</field>
            <field name="sequence" eval="25"/>
            <field name="code">OT</field>
            <field name="category_id" ref="hudson_payroll_base.rule_category_alw"/>
            <field name="struct_id" ref="hudson_payroll_base.structure_base"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result, result_rate, result_qty = payslip._get_dynamic_overtime_values(contract, worked_days)
]]></field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- Shortage Deduction Salary Rule
             In the Earned Proration model this rule returns 0.0.
             Attendance shortfalls are already reflected in the prorated BASIC/HRA/DA
             values (WORK100 hours / Scheduled hours). Keeping the rule here with 0.0
             so that existing payslips that reference SHORT code don't break.
             The rule is hidden from the payslip (appears_on_payslip=False). -->
        <record id="hr_rule_shortage_deduction" model="hr.salary.rule">
            <field name="name">Shortage Deduction</field>
            <field name="sequence" eval="26"/>
            <field name="code">SHORT</field>
            <field name="category_id" ref="hudson_payroll_base.rule_category_ded"/>
            <field name="struct_id" ref="hudson_payroll_base.structure_base"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
# Earned Proration model: shortfalls are absorbed in BASIC/HRA/DA proration.
# This rule always returns 0.0 and is hidden from the payslip.
result = 0.0
]]></field>
            <field name="appears_on_payslip" eval="False"/>
        </record>

        <!-- Unpaid Leave Deduction Salary Rule
             Handles formally approved LOP (Loss of Pay) leaves.
             Deducts at the contract day-rate for each unpaid leave day.
             In the Earned Proration model, unpaid leave hours are excluded from WORK100
             (so BASIC is already lower), and this rule deducts the remaining unpaid portion. -->
        <record id="hr_rule_unpaid" model="hr.salary.rule">
            <field name="name">Unpaid Leave Deduction</field>
            <field name="code">UNPAID</field>
            <field name="sequence" eval="27"/>
            <field name="category_id" ref="hudson_payroll_base.rule_category_ded"/>
            <field name="struct_id" ref="hudson_payroll_base.structure_base"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
if worked_days.UNPAID and worked_days.UNPAID.number_of_hours > 0.0:
    # Per-hour deduction for unpaid leave
    sched_data = payslip._get_attendance_vs_schedule(contract, payslip.date_from, payslip.date_to)
    sched_hours = sched_data.get('scheduled_hours', 0.0)
    if sched_hours > 0.0:
        nominal_gross = (contract.basic_salary or contract.wage or 0.0)
        per_hour_rate = nominal_gross / sched_hours
        raw_ded = worked_days.UNPAID.number_of_hours * per_hour_rate
    else:
        raw_ded = worked_days.UNPAID.number_of_hours * contract.get_period_shortage_rate(payslip.date_from, payslip.date_to)
elif worked_days.UNPAID and worked_days.UNPAID.number_of_days > 0.0:
    raw_ded = worked_days.UNPAID.number_of_days * contract.get_period_day_rate(payslip.date_from, payslip.date_to)
else:
    raw_ded = 0.0
total_earnings = categories.BASIC + categories.ALW
result = -min(raw_ded, total_earnings) if total_earnings > 0.0 else 0.0
result_qty = 1.0
]]></field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

        <!-- struct_id set directly on each rule above - no separate
             rule_ids wiring block needed (hr.payroll.structure.rule_ids
             is a One2many, not a stored Many2many; setting struct_id on
             the rule is the reliable way to attach it, rather than an
             (4, ref(...)) command whose behaviour on a One2many field
             is not guaranteed across Odoo versions). -->
    </data>
</odoo>
