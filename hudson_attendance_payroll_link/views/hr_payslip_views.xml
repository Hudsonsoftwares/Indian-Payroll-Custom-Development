<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_form_inherit_discrepancy" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.discrepancy</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="has_attendance_discrepancy" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_attendance_discrepancy"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        type="object"
                        invisible="not has_attendance_discrepancy">
                    <field name="attendance_discrepancy_string" widget="statinfo" string="Attendance Mismatch"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
