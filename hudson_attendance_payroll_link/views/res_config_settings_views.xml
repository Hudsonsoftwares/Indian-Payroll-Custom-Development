<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hudson.attendance.payroll.link</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Attendance &amp; Payroll Connection" name="attendance_payroll_connection_setting_container">
                    <setting id="overtime_multiplier_setting" string="Overtime Rate Multiplier" help="Default multiplier for overtime rate calculation.">
                        <div class="content-group mt4">
                            <field name="overtime_multiplier"/>
                        </div>
                    </setting>
                    <setting id="pay_overtime_setting" string="Pay Overtime" help="Enable or disable overtime salary calculations and payouts on payslips.">
                        <field name="pay_overtime"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
