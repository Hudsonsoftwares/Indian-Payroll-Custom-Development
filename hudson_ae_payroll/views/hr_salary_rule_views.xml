<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Salary Rule Form View with Include in GPSSA Contribution Base Checkbox -->
    <record id="hds_ae_hr_salary_rule_view_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit.hudson.ae.payroll</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_salary_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='appears_on_payslip']" position="after">
                <field name="hds_ae_include_in_gpssa_base"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Salary Rule List/Tree View with Include in GPSSA Contribution Base Column -->
    <record id="hds_ae_hr_salary_rule_view_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.tree.inherit.hudson.ae.payroll</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_salary_rule_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="hds_ae_include_in_gpssa_base" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
