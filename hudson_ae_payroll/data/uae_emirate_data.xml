        </record>

        <record id="emirate_fuj" model="uae.emirate">
            <field name="name">Fujairah</field>
            <field name="code">FUJ</field>
            <field name="pension_authority_id" ref="pension_authority_gpssa"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
