        </record>

        <record id="emirate_ajm" model="uae.emirate">
            <field name="name">Ajman</field>
            <field name="code">AJM</field>
            <field name="pension_authority_id" ref="pension_authority_gpssa"/>
            <field name="active" eval="True"/>
        </record>

        <record id="emirate_uaq" model="uae.emirate">
            <field name="name">Umm Al Quwain</field>
