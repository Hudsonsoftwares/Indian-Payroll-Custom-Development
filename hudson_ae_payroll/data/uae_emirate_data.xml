<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 7 Emirates of UAE with Statutory Pension Authority Mappings -->
        <record id="emirate_auh" model="uae.emirate">
            <field name="name">Abu Dhabi</field>
            <field name="code">AUH</field>
            <field name="pension_authority_id" ref="pension_authority_adpf"/>
            <field name="active" eval="True"/>
        </record>

        <record id="emirate_dxb" model="uae.emirate">
            <field name="name">Dubai</field>
            <field name="code">DXB</field>
            <field name="pension_authority_id" ref="pension_authority_gpssa"/>
            <field name="active" eval="True"/>
        </record>

        <record id="emirate_shj" model="uae.emirate">
            <field name="name">Sharjah</field>
            <field name="code">SHJ</field>
