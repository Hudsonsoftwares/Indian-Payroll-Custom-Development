<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Multi-Company Rule for Resignation -->
        <record id="hr_resignation_multi_company_rule" model="ir.rule">
            <field name="name">Employee Resignation Multi-Company</field>
            <field name="model_id" ref="model_hr_resignation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Resignation Personal Rule -->
        <record id="hr_resignation_employee_rule" model="ir.rule">
            <field name="name">Employee Resignation: Own Requests</field>
            <field name="model_id" ref="model_hr_resignation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- HR Manager/Officer Global Rule -->
        <record id="hr_resignation_manager_rule" model="ir.rule">
            <field name="name">Employee Resignation: All Requests for HR Officers</field>
            <field name="model_id" ref="model_hr_resignation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- Multi-Company Rule for Clearances -->
        <record id="hudson_exit_clearance_multi_company_rule" model="ir.rule">
            <field name="name">Exit Clearance Multi-Company</field>
            <field name="model_id" ref="model_hudson_exit_clearance"/>
            <field name="domain_force">['|', ('resignation_id.company_id', '=', False), ('resignation_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
