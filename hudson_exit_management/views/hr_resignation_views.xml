<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Resignation Tree / List View -->
        <record id="view_hr_resignation_tree" model="ir.ui.view">
            <field name="name">hr.resignation.list</field>
            <field name="model">hr.resignation</field>
            <field name="arch" type="xml">
                <list string="Employee Resignations" decoration-info="state == 'draft'" decoration-warning="state == 'confirm'" decoration-primary="state == 'approved'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="resignation_type" optional="show"/>
                    <field name="request_date"/>
                    <field name="expected_revealing_date"/>
                    <field name="approved_revealing_date" optional="show"/>
                    <field name="notice_period" optional="hide"/>
                    <field name="notice_shortage_days" optional="show"/>
                    <field name="clearance_status" widget="badge" decoration-success="clearance_status == 'cleared'" decoration-warning="clearance_status == 'in_progress'" decoration-danger="clearance_status == 'rejected'" optional="show"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirm'" decoration-primary="state == 'approved'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <!-- Resignation Form View -->
        <record id="view_hr_resignation_form" model="ir.ui.view">
            <field name="name">hr.resignation.form</field>
            <field name="model">hr.resignation</field>
            <field name="arch" type="xml">
                <form string="Employee Resignation">
                    <header>
                        <button name="action_confirm" string="Submit Resignation" type="object" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'confirm'" groups="hr.group_hr_user" class="btn-primary"/>
                        <button name="action_done" string="Complete Exit" type="object" invisible="state != 'approved'" groups="hr.group_hr_user" class="btn-success"/>
                        <button name="action_cancel" string="Cancel Request" type="object" invisible="state in ('done', 'cancel')"/>
                        <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approved,done"/>
                    </header>
                    <sheet>
                        <field name="settlement_count" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_final_settlement" type="object" class="oe_stat_button" icon="fa-calculator" invisible="settlement_count == 0">
                                <field name="settlement_count" widget="statinfo" string="Settlements"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Resignation Reference"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Employee Information">
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="department_id"/>
                                <field name="manager_id"/>
                                <field name="resignation_type" readonly="state not in ('draft', 'confirm')"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Timeline &amp; Notice Period">
                                <field name="request_date" readonly="state != 'draft'"/>
                                <field name="joined_date"/>
                                <field name="employee_contract"/>
                                <field name="notice_period"/>
                                <field name="expected_revealing_date" readonly="state != 'draft'"/>
                                <field name="approved_revealing_date" readonly="state not in ('confirm', 'approved')"/>
                                <field name="notice_shortage_days"/>
                            </group>
                        </group>
                        <group string="Reason for Resignation">
                            <field name="reason" placeholder="Please state the specific reason for resignation / exit..." readonly="state != 'draft'"/>
                        </group>
                        <notebook>
                            <page string="Department Clearances" name="clearances">
                                <group>
                                    <field name="clearance_status" widget="badge" decoration-success="clearance_status == 'cleared'" decoration-warning="clearance_status == 'in_progress'" decoration-danger="clearance_status == 'rejected'"/>
                                </group>
                                <field name="clearance_line_ids" readonly="state in ('done', 'cancel')">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="department_type"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="responsible_user_id"/>
                                        <field name="clearance_date"/>
                                        <field name="state" widget="badge" decoration-success="state == 'cleared'" decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'"/>
                                        <field name="remarks"/>
                                        <button name="action_mark_cleared" type="object" string="Clear" icon="fa-check" invisible="state == 'cleared'" class="btn-link"/>
                                        <button name="action_mark_rejected" type="object" string="Hold" icon="fa-times" invisible="state == 'rejected'" class="btn-link text-danger"/>
                                        <button name="action_reset_pending" type="object" string="Reset" icon="fa-undo" invisible="state == 'pending'" class="btn-link text-muted"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Internal Notes" name="notes">
                                <field name="notes" placeholder="Notes for HR and management..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hr_resignation_search" model="ir.ui.view">
            <field name="name">hr.resignation.search</field>
            <field name="model">hr.resignation</field>
            <field name="arch" type="xml">
                <search string="Search Resignations">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="My Resignations" name="my_resignations" domain="[('employee_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirm" domain="[('state', '=', 'confirm')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                    <group>
                        <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Exit Type" name="group_type" context="{'group_by': 'resignation_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Window -->
        <record id="action_hr_resignation" model="ir.actions.act_window">
            <field name="name">Resignations &amp; Exit Requests</field>
            <field name="res_model">hr.resignation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_resignation_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Submit or record an employee resignation or exit request.
                </p>
            </field>
        </record>
    </data>
</odoo>
