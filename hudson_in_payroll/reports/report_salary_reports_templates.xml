                        </thead>
                        <tbody>
                            <tr t-foreach="s_rows" t-as="sr">
                                <td class="text-left"><span t-esc="sr['emp_ref']"/></td>
                                <td class="text-left"><strong><span t-esc="sr['emp_name']"/></strong></td>
                                <td class="text-left"><span t-esc="sr['department']"/></td>
                                <td class="text-left"><span t-esc="sr['job_position']"/></td>
                                <t t-foreach="sr['months']" t-as="m_amt">
