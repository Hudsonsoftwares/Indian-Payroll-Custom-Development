                                <td class="text-right" style="font-weight: bold; background-color: #FDF2E9;"><span t-esc="'{:,.2f}'.format(sr['ann_ded'])"/></td>
                                <td class="text-right" style="font-weight: bold; background-color: #EAF2E8; color: #1e4620;"><span t-esc="'{:,.2f}'.format(sr['ann_net'])"/></td>
                                <td class="text-right" style="font-weight: bold; background-color: #EBF1F5;"><span t-esc="'{:,.2f}'.format(sr['ann_ctc'])"/></td>
                            </tr>
                            <tr class="total-row">
                                <td colspan="4" class="text-center">TOTAL (<span t-esc="len(s_rows)"/> Employees)</td>
