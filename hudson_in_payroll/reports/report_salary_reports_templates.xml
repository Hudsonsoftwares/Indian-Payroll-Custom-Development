    <!-- TEMPLATE 3: YEARLY SALARY BY EMPLOYEE WIZARD REPORT                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <template id="report_yearly_salary_employee_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="yearly_data" t-value="o._get_yearly_data()"/>
                <t t-set="s_rows" t-value="yearly_data['summary_rows']"/>
                <t t-set="a_tots" t-value="yearly_data['annual_totals']"/>
                <t t-set="d_rows" t-value="yearly_data['detail_rows']"/>

                <!-- PAGE 1: YEARLY SUMMARY MATRIX -->
                <div class="article rpt-container" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <t t-call="hudson_in_payroll.salary_reports_style"/>

                    <div class="rpt-header">
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 60%; vertical-align: middle;">
                                    <div class="rpt-title">YEARLY SALARY SUMMARY BY EMPLOYEE — <span t-esc="o.year"/></div>
                                    <div class="rpt-subtitle">
                                        <strong>Company:</strong> <span t-esc="o.company_id.name"/> |
                                        <strong>Year:</strong> <span t-esc="o.year"/> |
                                        <strong>Status Filter:</strong> <span t-esc="dict(o._fields['payslip_state'].selection).get(o.payslip_state)"/>
                                    </div>
                                </td>
                                <td style="width: 40%; text-align: right; vertical-align: middle;">
                                    <div class="rpt-subtitle">
                                        <strong>Generated:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y %H:%M')"/><br/>
                                        <strong>Total Employees:</strong> <span t-esc="len(s_rows)"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <h4 style="font-size: 10px; font-weight: bold; color: #1F4E78; margin-top: 5px; margin-bottom: 3px;">
                        Sheet 1: Monthly Net Salary Matrix
