                    <table class="rpt-table">
                        <thead>
                            <tr>
                                <th style="width: 4.5%;">Emp ID</th>
                                <th style="width: 9.5%;">Employee Name</th>
                                <th style="width: 7.5%;">Department</th>
                                <th style="width: 7.5%;">Job Position</th>
                                <th style="width: 4.5%;">Jan</th>
                                <th style="width: 4.5%;">Feb</th>
                                <th style="width: 4.5%;">Mar</th>
                                <th style="width: 4.5%;">Apr</th>
                                <th style="width: 4.5%;">May</th>
                                <th style="width: 4.5%;">Jun</th>
                                <th style="width: 4.5%;">Jul</th>
                                <th style="width: 4.5%;">Aug</th>
                                <th style="width: 4.5%;">Sep</th>
                                <th style="width: 4.5%;">Oct</th>
                                <th style="width: 4.5%;">Nov</th>
                                <th style="width: 4.5%;">Dec</th>
                                <th class="th-earn" style="width: 5.5%;">Ann. Gross</th>
