<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Professional Tax Employee Deduction Rule (Thin HrPayslip API Delegated) -->
        <record id="hds_in_rule_pt" model="hr.salary.rule">
            <field name="name">Professional Tax</field>
            <field name="code">PT</field>
            <field name="sequence" eval="165"/>
            <field name="category_id" ref="hudson_payroll_base.rule_category_ded"/>
            <field name="struct_id" ref="hudson_payroll_base.structure_base"/>
            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[result = bool(employee and employee.hds_in_pt_applicable)]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[result = payslip_record.hds_in_compute_professional_tax()]]></field>
            <field name="appears_on_payslip">non_zero</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
