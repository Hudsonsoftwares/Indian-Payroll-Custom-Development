    {
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Data",
      "colNumber": 5,
      "rowNumber": 20,
      "rows": {},
      "cells": {
        "A1": "=_t(\"Average Net Wage\")",
        "A2": "=_t(\"Prior Net Baseline\")",
        "A3": "=_t(\"Average Basic Wage\")",
        "A4": "=_t(\"Prior Basic Baseline\")",
        "A5": "=_t(\"Total Net Wage\")",
        "A6": "=_t(\"Total Basic Wage\")",
        "A7": "=_t(\"Avg Hours/Days\")",
        "A8": "=_t(\"Prior Hours Baseline\")",
        "A9": "=_t(\"Headcount\")",
        "A10": "=_t(\"FTE\")",
        "A11": "=_t(\"Employees Baseline\")",
        "B1": "=IFERROR(PIVOT.VALUE(1, \"net_amount\") / MAX(1, PIVOT.VALUE(1, \"__count\")), 0)",
        "B2": "=IFERROR(B1 * 0.9, 0)",
        "B3": "=IFERROR(PIVOT.VALUE(1, \"contract_wage\") / MAX(1, PIVOT.VALUE(1, \"__count\")), 0)",
        "B4": "=IFERROR(B3 * 0.95, 0)",
        "B5": "=PIVOT.VALUE(1, \"net_amount\")",
        "B6": "=PIVOT.VALUE(1, \"contract_wage\")",
        "B7": "8",
        "B8": "8",
        "B9": "=PIVOT.VALUE(2, \"__count\")",
        "B10": "=IFERROR(ROUND(B9 * 0.998, 2), 0)",
        "B11": "=CONCATENATE(FORMAT.LARGE.NUMBER(B9), _t(\" Employees\"))",
        "C1": "=FORMAT.LARGE.NUMBER(B1)",
        "C2": "=FORMAT.LARGE.NUMBER(B2)",
        "C3": "=FORMAT.LARGE.NUMBER(B3)",
        "C4": "=FORMAT.LARGE.NUMBER(B4)",
        "C5": "=FORMAT.LARGE.NUMBER(B5)",
        "C6": "=FORMAT.LARGE.NUMBER(B6)",
        "C7": "8",
        "C8": "8",
        "C9": "=FORMAT.LARGE.NUMBER(B9)",
        "C10": "=FORMAT.LARGE.NUMBER(B10)",
        "C11": "=B11"
      },
