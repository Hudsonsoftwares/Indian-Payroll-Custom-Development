<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Indian Payroll Benefits -->
        <record id="benefit_meal_vouchers" model="hr.payroll.benefit">
            <field name="name">Meal Vouchers</field>
            <field name="benefit_type">monthly_in_kind</field>
            <field name="benefit_source">employee</field>
            <field name="structure_type_id" ref="hr.structure_type_employee"/>
            <field name="sequence">10</field>
            <field name="description">Monthly food coupons / meal vouchers provided to employees.</field>
        </record>

        <record id="benefit_phone_subscription" model="hr.payroll.benefit">
            <field name="name">Phone Subscription</field>
            <field name="benefit_type">monthly_in_kind</field>
            <field name="benefit_source">employee</field>
            <field name="structure_type_id" ref="hr.structure_type_employee"/>
            <field name="sequence">20</field>
            <field name="description">Monthly mobile phone reimbursement / corporate plan allowance.</field>
        </record>

        <record id="benefit_internet_subscription" model="hr.payroll.benefit">
            <field name="name">Internet Subscription</field>
            <field name="benefit_type">monthly_in_kind</field>
            <field name="benefit_source">employee</field>
            <field name="structure_type_id" ref="hr.structure_type_employee"/>
            <field name="sequence">30</field>
            <field name="description">Monthly broadband / internet reimbursement for remote work.</field>
        </record>

        <record id="benefit_company_transport" model="hr.payroll.benefit">
            <field name="name">Company Transport</field>
            <field name="benefit_type">monthly_in_kind</field>
            <field name="benefit_source">employee</field>
            <field name="structure_type_id" ref="hr.structure_type_employee"/>
            <field name="sequence">40</field>
            <field name="description">Company shuttle or cab transport facility benefit.</field>
        </record>
    </data>
</odoo>
