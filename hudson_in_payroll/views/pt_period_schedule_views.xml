<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View for Professional Tax Period Schedules -->
    <record id="pt_period_schedule_view_tree" model="ir.ui.view">
        <field name="name">pt.period.schedule.view.list</field>
        <field name="model">pt.period.schedule</field>
        <field name="arch" type="xml">
            <list string="Professional Tax Period Schedules" multi_edit="1">
                <field name="state_id"/>
                <field name="periodicity"/>
                <field name="window_start_month"/>
                <field name="window_end_month"/>
                <field name="deduction_strategy"/>
                <field name="distribution_method"/>
                <field name="deduction_month" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View for Professional Tax Period Schedules -->
    <record id="pt_period_schedule_view_form" model="ir.ui.view">
        <field name="name">pt.period.schedule.view.form</field>
        <field name="model">pt.period.schedule</field>
        <field name="arch" type="xml">
            <form string="Professional Tax Period Schedule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="Automated Schedule Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="state_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="periodicity"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group string="Aggregation Window" invisible="periodicity == 'monthly'">
                            <field name="window_start_month" required="periodicity in ('half_yearly', 'quarterly', 'annual')"/>
                            <field name="window_end_month" required="periodicity in ('half_yearly', 'quarterly', 'annual')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Deduction Strategy">
                            <field name="deduction_strategy"/>
                            <field name="distribution_method"/>
                            <field name="deduction_month" invisible="periodicity == 'monthly' or deduction_strategy == 'every_payroll'" required="periodicity == 'half_yearly' and deduction_strategy == 'specific_month'"/>
                        </group>
                        <group string="Effective Validity">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Statutory References &amp; Remarks">
                            <field name="remarks" placeholder="Statutory notes, gazette references, or caveats..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Professional Tax Period Schedules -->
    <record id="pt_period_schedule_view_search" model="ir.ui.view">
        <field name="name">pt.period.schedule.view.search</field>
        <field name="model">pt.period.schedule</field>
        <field name="arch" type="xml">
            <search string="Search PT Period Schedules">
                <field name="name"/>
                <field name="state_id"/>
                <field name="periodicity"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Periodicity" name="group_periodicity" context="{'group_by': 'periodicity'}"/>
                    <filter string="Deduction Strategy" name="group_strategy" context="{'group_by': 'deduction_strategy'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Professional Tax Period Schedules -->
    <record id="action_pt_period_schedule" model="ir.actions.act_window">
        <field name="name">PT Period Schedules</field>
        <field name="res_model">pt.period.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pt_period_schedule_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Professional Tax Period Schedules!
            </p>
            <p>
                Professional Tax Period Schedules define when tax deductions occur and statutory aggregation windows for states like Kerala, Tamil Nadu, and Maharashtra.
            </p>
        </field>
    </record>

    <!-- Menu Item for PT Period Schedules under Indian Statutory Configuration -->
    <menuitem id="menu_pt_period_schedule"
              name="PT Period Schedules"
              parent="menu_hds_in_tds_configuration"
              action="action_pt_period_schedule"
              sequence="60"/>

</odoo>
