<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vibrant & Attractive Kanban Dashboard View for Enterprise Statutory Compliance Reports -->
    <record id="hds_in_statutory_report_view_kanban" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.kanban</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="id"/>
                <field name="statutory_module"/>
                <field name="rule_code"/>
                <field name="rule_name"/>
                <field name="employee_id"/>
                <field name="statutory_amount"/>
                <field name="calculation_date"/>
                <field name="status"/>
                <field name="company_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-3 border-0 rounded-3 shadow-sm bg-white border-start border-4 #{record.status.raw_value == 'success' ? 'border-success' : (record.status.raw_value == 'warning' ? 'border-warning' : 'border-danger')} transition-all">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span t-attf-class="badge px-2 py-1 fs-6 text-uppercase #{record.statutory_module.raw_value == 'epf' ? 'bg-primary' : (record.statutory_module.raw_value == 'pt' ? 'bg-info text-dark' : (record.statutory_module.raw_value == 'esic' ? 'bg-secondary' : 'bg-dark'))}">
                                    <i class="fa fa-shield me-1"/>
                                    <field name="statutory_module"/>
                                </span>
                                <span t-attf-class="badge px-2 py-1 #{record.status.raw_value == 'success' ? 'bg-success-subtle text-success border border-success' : (record.status.raw_value == 'warning' ? 'bg-warning-subtle text-warning-emphasis border border-warning' : 'bg-danger-subtle text-danger border border-danger')}">
                                    <i t-attf-class="fa #{record.status.raw_value == 'success' ? 'fa-check-circle' : (record.status.raw_value == 'warning' ? 'fa-exclamation-triangle' : 'fa-times-circle')} me-1"/>
                                    <field name="status"/>
                                </span>
                            </div>
                            <div class="my-2">
                                <h5 class="fw-bold mb-0 text-dark"><field name="employee_id"/></h5>
                                <div class="text-muted small">
                                    <i class="fa fa-calculator me-1 text-primary"/>Rule: <strong><field name="rule_name"/></strong> (<field name="rule_code"/>)
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-end mt-3 pt-2 border-top border-light">
                                <div>
                                    <div class="text-muted small"><i class="fa fa-calendar me-1"/>Date</div>
                                    <span class="fw-semibold text-body"><field name="calculation_date"/></span>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small">Deduction</div>
                                    <span class="fs-5 fw-bold text-success">
                                        ₹ <field name="statutory_amount"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List / Tree View for Enterprise Statutory Compliance Report (Read-Only) -->
    <record id="hds_in_statutory_report_view_tree" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.list</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <list string="Enterprise Statutory Reports" create="false" edit="false" delete="false"
                  decoration-success="status == 'success'"
                  decoration-warning="status == 'warning'"
                  decoration-danger="status == 'error'">
                <field name="calculation_date"/>
                <field name="statutory_module" optional="show"/>
                <field name="rule_code" optional="show"/>
                <field name="rule_name" optional="show"/>
                <field name="employee_id"/>
                <field name="payslip_id" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="statutory_amount" sum="Total Statutory Amount"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'error'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for Enterprise Statutory Compliance Report (Read-Only) -->
    <record id="hds_in_statutory_report_view_form" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.form</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <form string="Statutory Report Record" create="false" edit="false" delete="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="success,warning,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="rule_name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="employee_id"/>
                        </group>
                        <group string="Statutory &amp; Payroll Context">
                            <field name="statutory_module"/>
                            <field name="rule_code"/>
                            <field name="payslip_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="statutory_amount"/>
                            <field name="calculation_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Enterprise Statutory Compliance Report -->
    <record id="hds_in_statutory_report_view_search" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.search</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <search string="Search Statutory Reports">
                <field name="employee_id"/>
                <field name="payslip_id"/>
                <field name="rule_code"/>
                <field name="rule_name"/>
                <field name="statutory_module"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <!-- Quick Filters for Statutory Modules -->
                <filter string="Provident Fund (EPF)" name="filter_epf" domain="[('statutory_module', '=', 'epf')]"/>
                <filter string="Professional Tax (PT)" name="filter_pt" domain="[('statutory_module', '=', 'pt')]"/>
                <filter string="ESIC" name="filter_esic" domain="[('statutory_module', '=', 'esic')]"/>
                <filter string="Labour Welfare Fund (LWF)" name="filter_lwf" domain="[('statutory_module', '=', 'lwf')]"/>
                <filter string="Gratuity" name="filter_gratuity" domain="[('statutory_module', '=', 'gratuity')]"/>
                <filter string="Income Tax (TDS)" name="filter_tds" domain="[('statutory_module', '=', 'tds')]"/>

                <separator/>
                <!-- Status Filters -->
                <filter string="Success" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Warnings" name="filter_warning" domain="[('status', '=', 'warning')]"/>
                <filter string="Errors" name="filter_error" domain="[('status', '=', 'error')]"/>

                <group>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Statutory Module" name="group_by_module" context="{'group_by': 'statutory_module'}"/>
                    <filter string="Rule Code" name="group_by_rule" context="{'group_by': 'rule_code'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Processing Date" name="group_by_date" context="{'group_by': 'calculation_date'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View for Enterprise Statutory Compliance Report -->
    <record id="hds_in_statutory_report_view_pivot" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.pivot</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <pivot string="Statutory Report Analysis" sample="1">
                <field name="employee_id" type="row"/>
                <field name="calculation_date" interval="month" type="col"/>
                <field name="statutory_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Enterprise Statutory Compliance Report -->
    <record id="hds_in_statutory_report_view_graph" model="ir.ui.view">
        <field name="name">hds.in.statutory.report.graph</field>
        <field name="model">hds.in.statutory.report</field>
        <field name="arch" type="xml">
            <graph string="Statutory Report Graphical Analytics" type="bar" sample="1">
                <field name="calculation_date" interval="month"/>
                <field name="statutory_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Base Window Action for General Statutory Report Engine -->
    <record id="action_hds_in_statutory_report_general" model="ir.actions.act_window">
        <field name="name">Statutory Compliance Reports</field>
        <field name="res_model">hds.in.statutory.report</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>

    <!-- Specific Window Action for Professional Tax Statutory Reports -->
    <record id="action_hds_in_pt_statutory_report" model="ir.actions.act_window">
        <field name="name">Professional Tax Statutory Reports</field>
        <field name="res_model">hds.in.statutory.report</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="domain">[('statutory_module', '=', 'pt')]</field>
        <field name="context">{'default_statutory_module': 'pt'}</field>
    </record>
</odoo>
