<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- House Property Loss Carry-Forward (71B) Form View (Wizard / Modal Dialog) -->
    <record id="view_tds_house_property_loss_carryforward_form" model="ir.ui.view">
        <field name="name">tds.house.property.loss.carryforward.form</field>
        <field name="model">tds.house.property.loss.carryforward</field>
        <field name="arch" type="xml">
            <form string="House Property Loss Carry-Forward (Section 71B)">
                <header>
                    <button name="action_verify" string="Verify Loss Claim" type="object" class="oe_highlight" invisible="verification_status == 'verified'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="verification_status == 'rejected'"/>
                    <button name="action_reset_pending" string="Reset to Pending" type="object" invisible="verification_status == 'pending'"/>
                    <field name="verification_status" widget="statusbar" statusbar_visible="pending,verified,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee &amp; Financial Year">
                            <field name="employee_id"/>
                            <field name="financial_year_id"/>
                            <field name="origin_assessment_year" placeholder="e.g. 2025-2026"/>
                            <field name="expiry_assessment_year" placeholder="e.g. 2033-2034"/>
                            <field name="regime_code"/>
                            <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-success="status == 'active'" decoration-muted="status == 'fully_utilized'" decoration-danger="status == 'expired'"/>
                        </group>
                        <group string="Section 71B Loss &amp; Set-Off Details">
                            <field name="unabsorbed_loss_amount"/>
                            <field name="utilized_amount"/>
                            <field name="remaining_balance" class="oe_subtotal_footer_separator"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <group string="HR Verification Details">
                        <group>
                            <field name="verification_remarks" placeholder="Add verification notes, ITR-V acknowledgment details, or rejection reasons..."/>
                        </group>
                        <group>
                            <field name="verified_by"/>
                            <field name="verified_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- House Property Loss Carry-Forward (71B) List View -->
    <record id="view_tds_house_property_loss_carryforward_tree" model="ir.ui.view">
        <field name="name">tds.house.property.loss.carryforward.list</field>
        <field name="model">tds.house.property.loss.carryforward</field>
        <field name="arch" type="xml">
            <list string="House Property Loss Carry-Forward (Section 71B)" decoration-success="verification_status == 'verified'" decoration-danger="verification_status == 'rejected'" decoration-warning="verification_status == 'pending'">
                <field name="employee_id"/>
                <field name="financial_year_id" optional="show"/>
                <field name="origin_assessment_year" optional="show"/>
                <field name="expiry_assessment_year" optional="show"/>
                <field name="unabsorbed_loss_amount"/>
                <field name="utilized_amount" optional="show"/>
                <field name="remaining_balance" optional="show"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-success="status == 'active'" decoration-muted="status == 'fully_utilized'" decoration-danger="status == 'expired'"/>
                <field name="verification_status" widget="badge" decoration-success="verification_status == 'verified'" decoration-danger="verification_status == 'rejected'" decoration-warning="verification_status == 'pending'"/>
                <field name="verified_by" optional="hide"/>
                <field name="verified_on" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Window Action for Section 71B (Dialog/Popup Form Rendering Only - Zero Menus Attached) -->
    <record id="action_tds_house_property_loss_carryforward" model="ir.actions.act_window">
        <field name="name">House Property Loss Carry-Forward (71B)</field>
        <field name="res_model">tds.house.property.loss.carryforward</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Unabsorbed House Property losses exceeding current-year set-off limits are recorded here under Section 71B for inter-year set-off against future House Property income.
            </p>
        </field>
    </record>
</odoo>
