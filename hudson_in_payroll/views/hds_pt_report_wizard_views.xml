<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Professional Tax Report Wizard Form View (ESIC / Labour Format) -->
    <record id="hds_pt_report_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.pt.report.wizard.view.form</field>
        <field name="model">hds.pt.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Professional Tax (PT) Report Wizard">
                <header>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_generate_xlsx"
                            string="Export XLSX File"
                            type="object"
                            class="btn-success"
                            icon="fa-file-excel-o"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Report Configuration">
                            <field name="year" required="1"/>
                            <field name="month" required="1"/>
                            <field name="report_type" required="1" widget="radio"/>
                            <field name="payslip_state"/>
                            <field name="state_id" options="{'no_create': True}" placeholder="All States / Filter by State"/>
                            <field name="employee_id" options="{'no_create': True}" placeholder="All Employees / Specific Employee"/>
                            <field name="company_id" groups="base.group_multi_company" required="1"/>
                        </group>
                        <group string="Summary Statistics" invisible="state == 'draft'">
                            <field name="record_count" readonly="1"/>
                            <field name="total_pt_wages" readonly="1"/>
                            <field name="total_pt_deduction" readonly="1"/>
                        </group>
                    </group>
                    <group string="Generated Report File for Download" invisible="state == 'draft'">
                        <field name="xlsx_filename" invisible="1"/>
                        <field name="xlsx_file" filename="xlsx_filename" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Professional Tax Report Wizard List / History View -->
    <record id="hds_pt_report_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.pt.report.wizard.view.list</field>
        <field name="model">hds.pt.report.wizard</field>
        <field name="arch" type="xml">
            <list string="Professional Tax Report Log">
                <field name="name"/>
                <field name="report_type" optional="show"/>
                <field name="year" optional="show"/>
                <field name="month" optional="show"/>
                <field name="state_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="record_count" optional="show"/>
                <field name="total_pt_wages" optional="show"/>
                <field name="total_pt_deduction" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Window Action for PT Report Wizard -->
    <record id="action_hds_pt_report_wizard" model="ir.actions.act_window">
        <field name="name">Professional Tax (PT) Report</field>
        <field name="res_model">hds.pt.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
