<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Extend Payslip Form View with Statutory Audits & Column Visibility Toggles -->
    <record id="hds_in_view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.hudson.payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund_sheet']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="hds_in_tds_applicable" invisible="1"/>
                <button name="action_print_statutory_report"
                        string="Download Tax Calculation Report"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-pdf-o"
                        invisible="not hds_in_tds_applicable"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_statutory_audits"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shield"
                        invisible="hds_in_statutory_audit_count == 0">
                    <field name="hds_in_statutory_audit_count" widget="statinfo" string="Statutory Audits"/>
                </button>
            </xpath>

            <!-- Payment Mode in Other Info Tab -->
            <xpath expr="//page[@name='other_info']//field[@name='payment_date']" position="after">
                <field name="hds_in_payment_mode" string="Payment Mode"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="ESIC Statutory Exemption (Rule 51-B)" name="esic_rule_51b_info">
                    <group>
                        <field name="hds_in_esic_daily_wage_exempt"/>
                        <field name="hds_in_esic_average_daily_wage"/>
                        <field name="hds_in_esic_paid_days"/>
                    </group>
                </group>
            </xpath>

            <!-- Salary Computation Tab Column Toggles -->
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='category_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='sequence']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='quantity']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='rate']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/*[self::tree or self::list]/field[@name='amount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- Worked Days Tab Column Toggles -->
            <xpath expr="//field[@name='worked_days_line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/*[self::tree or self::list]/field[@name='number_of_hours']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- Inputs Tab Column Toggles -->
            <xpath expr="//field[@name='input_line_ids']/*[self::tree or self::list]/field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Main Payslips List View Toggles -->
    <record id="hds_in_view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.hudson.payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_from']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- 3. Payslip Batches List View Toggles -->
    <record id="hds_in_view_hr_payslip_run_tree" model="ir.ui.view">
        <field name="name">hr.payslip.run.tree.inherit.hudson.payroll</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payslip_run_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- 5. Salary Structures List View Toggles -->
    <record id="hds_in_view_hr_payroll_structure_tree" model="ir.ui.view">
        <field name="name">hr.payroll.structure.tree.inherit.hudson.payroll</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hudson_payroll_base.hr_payroll_structure_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
