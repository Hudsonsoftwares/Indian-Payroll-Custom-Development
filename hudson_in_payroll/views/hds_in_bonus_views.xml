<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bonus Document List View -->
    <record id="view_hds_in_bonus_tree" model="ir.ui.view">
        <field name="name">hds.in.bonus.list</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <list string="Bonus Documents" default_order="id desc">
                <field name="name"/>
                <field name="bonus_category" optional="show"/>
                <field name="payment_date" optional="show"/>
                <field name="payment_method" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-primary="state in ('submitted', 'manager_approved', 'hr_approved')"
                       decoration-warning="state == 'approved'"
                       decoration-success="state in ('processed', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Bonus Document Form View -->
    <record id="view_hds_in_bonus_form" model="ir.ui.view">
        <field name="name">hds.in.bonus.form</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <form string="Bonus Document">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_approve" string="Manager Approve" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_hr_approve" string="HR Approve" type="object" class="btn-primary" invisible="state != 'manager_approved'"/>
                    <button name="action_approve" string="Finance Approve / Ready" type="object" class="btn-primary" invisible="state != 'hr_approved'"/>
                    <button name="action_process_bonus" string="Process Bonus in Payroll" type="object" class="btn-primary" invisible="state not in ('approved', 'hr_approved')"/>
                    <button name="action_generate_separate_payroll" string="Generate Bonus Payroll" type="object" class="btn-primary" invisible="payment_method != 'separate_payroll' or state in ('processed', 'paid', 'cancelled')"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object" class="btn-success" invisible="state != 'processed'"/>
                    <button name="action_open_import_wizard" string="Import Bonus Lines" type="object" class="btn-secondary" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted', 'manager_approved', 'hr_approved', 'approved')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('processed', 'paid', 'cancelled')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,manager_approved,hr_approved,approved,processed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payslip_run" type="object" class="oe_stat_button" icon="fa-archive" invisible="not payslip_run_id">
                            <field name="payslip_count" widget="statinfo" string="Payslip Batch"/>
                        </button>
                        <button name="action_view_payslips" type="object" class="oe_stat_button" icon="fa-money" invisible="payslip_count == 0">
                            <field name="payslip_count" widget="statinfo" string="Payslips"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Diwali Festival Bonus 2026" readonly="state in ('processed', 'paid')"/></h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="bonus_category" readonly="state in ('processed', 'paid')"/>
                            <field name="payment_method" readonly="state in ('processed', 'paid')"/>
                            <field name="payment_date" readonly="state in ('processed', 'paid')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state in ('processed', 'paid')"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Payroll Period">
                            <field name="date_from" readonly="state in ('processed', 'paid')"/>
                            <field name="date_to" readonly="state in ('processed', 'paid')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="General Information" name="general_info">
                            <group>
                                <group string="Eligibility Rules">
                                    <field name="min_service_period_months" readonly="state in ('approved', 'processed', 'paid')"/>
                                    <field name="require_confirmed_employee" readonly="state in ('approved', 'processed', 'paid')"/>
                                </group>
                                <group string="Target Scope">
                                    <field name="employee_selection_type" widget="radio" readonly="state in ('approved', 'processed', 'paid')"/>
                                    <field name="target_department_ids" widget="many2many_tags" invisible="employee_selection_type != 'department'" required="employee_selection_type == 'department'" readonly="state in ('approved', 'processed', 'paid')"/>
                                    <field name="target_job_ids" widget="many2many_tags" invisible="employee_selection_type != 'job'" required="employee_selection_type == 'job'" readonly="state in ('approved', 'processed', 'paid')"/>
                                </group>
                            </group>

                            <group string="Calculation Engine">
                                <group>
                                    <field name="calculation_method" readonly="state in ('approved', 'processed', 'paid')"/>
                                    <field name="fixed_amount" invisible="calculation_method not in ('fixed', 'years_of_service')" required="calculation_method in ('fixed', 'years_of_service')" readonly="state in ('approved', 'processed', 'paid')"/>
                                    <field name="percentage" invisible="calculation_method in ('fixed', 'formula')" required="calculation_method not in ('fixed', 'formula')" readonly="state in ('approved', 'processed', 'paid')"/>
                                </group>
                                <group>
                                    <div class="oe_edit_only mt-2" col="2">
                                        <button name="action_generate_lines" string="Generate Bonus Lines" type="object" class="btn btn-secondary" invisible="state not in ('draft', 'submitted')"/>
                                    </div>
                                </group>
                            </group>

                            <group string="Python Formula" invisible="calculation_method != 'formula'">
                                <field name="formula_python" widget="ace" options="{'mode': 'python'}" readonly="state in ('approved', 'processed', 'paid')"/>
                            </group>

                            <group>
                                <group string="TDS Tax Configuration">
                                    <field name="tax_treatment" readonly="state in ('processed', 'paid')"/>
                                    <field name="tax_exempt_limit" invisible="tax_treatment != 'partial'" readonly="state in ('processed', 'paid')"/>
                                </group>
                                <group string="Accounting Integration">
                                    <field name="bonus_expense_account_id" readonly="state in ('processed', 'paid')"/>
                                    <field name="bonus_payable_account_id" readonly="state in ('processed', 'paid')"/>
                                    <field name="journal_id" readonly="state in ('processed', 'paid')"/>
                                    <field name="move_id" invisible="not move_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Bonus Lines" name="lines">
                            <field name="line_ids" readonly="state in ('approved', 'processed', 'paid')">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="department_id" optional="show"/>
                                    <field name="job_id" optional="show"/>
                                    <field name="contract_id" optional="hide"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="payslip_id" optional="show"/>
                                    <field name="state" widget="badge" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Payroll &amp; Disbursement" name="payroll_disbursement">
                            <group string="Disbursement Method">
                                <field name="payment_method" widget="radio" readonly="state in ('processed', 'paid')"/>
                            </group>

                            <group string="Separate Bonus Payroll Configuration" invisible="payment_method != 'separate_payroll'">
                                <group>
                                    <field name="struct_id" readonly="state in ('processed', 'paid')"/>
                                    <field name="payslip_run_id" readonly="1"/>
                                </group>
                                <group>
                                    <button name="action_generate_separate_payroll" string="Generate Bonus Payroll Batch" type="object" class="btn btn-primary" invisible="state in ('processed', 'paid', 'cancelled')"/>
                                </group>
                            </group>
                        </page>

                        <page string="Approval Audit Trail" name="approval_audit">
                            <group>
                                <group string="Manager Approval">
                                    <field name="manager_approved_by"/>
                                    <field name="manager_approved_date"/>
                                </group>
                                <group string="HR Approval">
                                    <field name="hr_approved_by"/>
                                    <field name="hr_approved_date"/>
                                </group>
                            </group>
                            <group string="Finance Approval">
                                <field name="finance_approved_by"/>
                                <field name="finance_approved_date"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes or references..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bonus Document Search View -->
    <record id="view_hds_in_bonus_search" model="ir.ui.view">
        <field name="name">hds.in.bonus.search</field>
        <field name="model">hds.in.bonus</field>
        <field name="arch" type="xml">
            <search string="Search Bonus Documents">
                <field name="name" string="Bonus Name"/>
                <field name="bonus_category"/>
                <field name="notes"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Processed" name="filter_processed" domain="[('state', '=', 'processed')]"/>
                <separator/>
                <group>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'bonus_category'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Bonus Documents -->
    <record id="action_hds_in_bonus" model="ir.actions.act_window">
        <field name="name">Bonus Management</field>
        <field name="res_model">hds.in.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hds_in_bonus_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Bonus Document!
            </p>
            <p>
                Bonus Management allows HR to configure, calculate, approve, and process festival, performance, statutory, and ex-gratia bonuses for employees either in monthly payroll or as a separate bonus payroll batch.
            </p>
        </field>
    </record>

    <!-- General Menu: Payroll -> Configuration -> Salary -> Bonus Management -->
    <menuitem id="menu_hds_in_bonus_config_doc"
              name="Bonus Management"
              parent="hudson_payroll_base.menu_hr_payroll_salary_root"
              sequence="80"
              action="action_hds_in_bonus"
              groups="hudson_payroll_base.group_payroll_manager"/>

    <!-- Operations Menu: Payroll -> Operations -> Bonus Management -->
    <menuitem id="menu_hds_in_bonus_operations"
              name="Bonus Management"
              parent="hudson_payroll_base.menu_hr_payroll_operations"
              sequence="15"
              action="action_hds_in_bonus"
              groups="hudson_payroll_base.group_payroll_user"/>
</odoo>
