<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Leave Type Form View to add Include in Leave Encashment Checkbox -->
    <record id="edit_holiday_status_form_inherit_hds_in_payroll" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.hds.in.payroll</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="priority" eval="9"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="Statutory &amp; Leave Encashment Configuration">
                    <field name="include_in_leave_encashment" string="Include in Leave Encashment"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit Leave Type Tree View to add Include in Leave Encashment Column -->
    <record id="view_holiday_status_normal_tree_inherit_hds_in_payroll" model="ir.ui.view">
        <field name="name">hr.leave.type.tree.inherit.hds.in.payroll</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="priority" eval="9"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="include_in_leave_encashment" string="Include in Leave Encashment"/>
            </xpath>
        </field>
    </record>
</odoo>
