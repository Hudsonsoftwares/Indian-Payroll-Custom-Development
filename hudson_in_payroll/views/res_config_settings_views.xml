<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_in_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hds.in.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hudson_payroll_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hudson_payroll_base']" position="inside">
                <field name="hds_in_is_india_company" invisible="1"/>
                <div class="hds_in_payroll_localization_container" invisible="not hds_in_is_india_company">
                    <h2 class="mt32">Indian Localization</h2>
                    <div class="row mt16 o_settings_container">
                        <!-- Left Column: EPF -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_epf_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_epf_applicable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_epf_applicable" string="Employee Provident Fund (EPF)" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable this to automatically calculate and deduct provident fund contributions from both employer and employee.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_epf_applicable">
                                    <div class="row mt8">
                                        <label for="hds_in_epf_employer_id" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_epf_employer_id" placeholder="e.g. MH/BAN/0012345/000"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: EDLI -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_edli_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_edli_applicable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_edli_applicable" string="Employee Deposit Linked Insurance (EDLI)" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable this to calculate the employer's EDLI contribution as part of statutory PF compliance.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_edli_applicable">
                                    <div class="row mt8">
                                        <label for="hds_in_edli_registration_number" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_edli_registration_number" placeholder="e.g. EDLI/12345/REG"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Left Column: EPS -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_eps_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_eps_applicable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_eps_applicable" string="Employee Pension Scheme (EPS)" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable this to automatically calculate and allocate pension contributions from the employer's PF contribution.
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: ESIC -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_esic_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_esic_applicable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_esic_applicable" string="Employees' State Insurance (ESIC)" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable Employee State Insurance (ESIC) statutory compliance for this company.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_esic_applicable">
                                    <div class="row mt8">
                                        <label for="hds_in_esic_employer_code" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_esic_employer_code" placeholder="e.g. 31000123450000101"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="hds_in_esic_registration_no" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_esic_registration_no" placeholder="e.g. ESIC/MH/3100012"/>
                                    </div>
                                    <div class="mt8">
                                        <button name="%(hudson_in_payroll.action_esic_contribution_period)d"
                                                icon="fa-arrow-right"
                                                type="action"
                                                string="Configure Contribution Periods"
                                                class="btn-link"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Left Column: LWF -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_lwf_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_lwf"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_lwf" string="Labour Welfare Fund (LWF)" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable Labour Welfare Fund (LWF) statutory compliance for this company.
                                </div>
                                <div class="mt-2">
                                    <field name="hds_in_lwf_threshold_info" widget="html" readonly="1" nolabel="1"/>
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_enable_lwf">
                                    <div class="row mt8">
                                        <label for="hds_in_lwf_registration_no" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_lwf_registration_no" placeholder="e.g. LWF/MH/2024/00123"/>
                                    </div>
                                </div>
                                <div class="mt8">
                                    <button name="%(hudson_in_payroll.action_lwf_state_rate_act)d"
                                            icon="fa-arrow-right"
                                            type="action"
                                            string="Configure State Rates &amp; Thresholds"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Gratuity -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_gratuity_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_gratuity"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_gratuity" string="Payment of Gratuity Act" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable Gratuity statutory compliance for this company under the Payment of Gratuity Act.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_enable_gratuity">
                                    <div class="row mt8">
                                        <label for="hds_in_gratuity_registration_no" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_gratuity_registration_no" placeholder="e.g. GR/MH/2024/00567"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Left Column: Leave Encashment -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_leave_encashment_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_leave_encashment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_leave_encashment" string="Enable Leave Encashment" class="fw-bold"/>
                                <div class="text-muted">
                                    Enable Leave Encashment statutory calculations and policy limits for this company.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_enable_leave_encashment">
                                    <div class="row mt8">
                                        <label for="hds_in_leave_encashment_registration_no" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_leave_encashment_registration_no" placeholder="e.g. LE/MH/2026/00123"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Notice Pay Settlement -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_notice_pay_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_notice_pay_settlement"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_notice_pay_settlement" string="Enable Notice Pay Settlement" class="fw-bold"/>
                                <div class="text-muted">
                                    When enabled, Notice Pay earnings or shortfall recovery will be calculated in Final Settlement.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_enable_notice_pay_settlement">
                                    <div class="row mt8">
                                        <label for="contract_expiration_notice_period" class="col-lg-5 o_light_label" string="Default Notice Period"/>
                                        <div class="col-lg-7 d-flex align-items-center">
                                            <field name="contract_expiration_notice_period" class="oe_inline"/>
                                            <field name="hds_in_notice_period_unit" class="oe_inline ms-2"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Left Column: Professional Tax (PT) -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_pt_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_professional_tax"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_professional_tax" string="Professional Tax (PT)" class="fw-bold"/>
                                <div class="text-muted">
                                    Determines whether the company is registered under the applicable State Professional Tax Act and liable to deduct Professional Tax.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_enable_professional_tax">
                                    <div class="row mt8">
                                        <label for="hds_in_professional_tax_registration_no" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_professional_tax_registration_no" placeholder="e.g. PTRC/MH/2026/00123"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Tax Deducted at Source (TDS) -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_tds_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_tds_applicable"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_tds_applicable" string="Tax Deducted at Source (TDS)" class="fw-bold"/>
                                <div class="text-muted">
                                    Master switch to enable or disable TDS statutory compliance and configure company TAN &amp; default tax regime preferences.
                                </div>
                                <div class="content-group mt8" invisible="not hds_in_tds_applicable">
                                    <div class="row mt8">
                                        <label for="hds_in_tan" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_tan" placeholder="e.g. ABCD12345E"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="hds_in_default_tax_regime" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_default_tax_regime"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="hds_in_default_tax_year" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_default_tax_year" placeholder="Select Default Tax Year"/>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- Statutory Audit Setting Box -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_statutory_audit_setting">
                            <div class="o_setting_left_pane">
                                <field name="hds_in_enable_statutory_audit"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="hds_in_enable_statutory_audit" string="Statutory Calculation Audit Logging" class="fw-bold"/>
                                <div class="text-muted">
                                    Record immutable JSON calculation input/output/parameter audit logs for statutory compliance &amp; inspection.
                                </div>
                            </div>
                        </div>

                        <!-- Payment Modes Configuration -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_payment_mode_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label fw-bold">Payment Modes</span>
                                <div class="text-muted">
                                    Configure the salary disbursement methods available in your organization
                                    (e.g. Bank Transfer, NEFT/RTGS, Cash, UPI). These modes appear on
                                    employee profiles and payslips.
                                </div>
                                <div class="mt8">
                                    <button name="%(hudson_in_payroll.action_hds_payment_mode)d"
                                            icon="fa-arrow-right"
                                            type="action"
                                            string="Configure Payment Modes"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </div>

                        <!-- Payroll Structures Configuration -->

                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_payroll_structures_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label fw-bold">Payroll Structure Configuration</span>
                                <div class="text-muted">
                                    Configure default salary structures for regular monthly payroll and bonus payroll processing.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row mt8">
                                        <label for="hds_in_regular_struct_id" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_regular_struct_id"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="hds_in_bonus_struct_id" class="col-lg-5 o_light_label"/>
                                        <field name="hds_in_bonus_struct_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Generic Bonus Configuration Setting Box -->
                        <div class="col-12 col-lg-6 o_setting_box" id="hds_in_bonus_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label fw-bold">Bonus Configuration</span>
                                <div class="text-muted">
                                    Configure bonus eligibility rules and tax applicability.
                                </div>
                                <div class="content-group mt8">
                                    <div class="field_boolean">
                                        <field name="hds_in_retention_exclude_notice_period"/>
                                        <label for="hds_in_retention_exclude_notice_period" string="Exclude Employees in Notice Period"/>
                                    </div>
                                    <div class="field_boolean mt-2">
                                        <field name="hds_in_bonus_apply_tds"/>
                                        <label for="hds_in_bonus_apply_tds" string="Apply TDS on Bonus"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
