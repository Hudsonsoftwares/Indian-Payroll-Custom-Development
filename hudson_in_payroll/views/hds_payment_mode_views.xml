<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- LIST VIEW                                                     -->
    <!-- ============================================================ -->
    <record id="hds_payment_mode_view_list" model="ir.ui.view">
        <field name="name">hds.payment.mode.list</field>
        <field name="model">hds.payment.mode</field>
        <field name="arch" type="xml">
            <list string="Payment Modes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_cash"/>
                <field name="active" optional="hide"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                     -->
    <!-- ============================================================ -->
    <record id="hds_payment_mode_view_form" model="ir.ui.view">
        <field name="name">hds.payment.mode.form</field>
        <field name="model">hds.payment.mode</field>
        <field name="arch" type="xml">
            <form string="Payment Mode">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Payment Mode Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. NEFT / RTGS"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. neft_rtgs"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_cash"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Optional internal notes about this payment mode..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WINDOW ACTION                                                 -->
    <!-- ============================================================ -->
    <record id="action_hds_payment_mode" model="ir.actions.act_window">
        <field name="name">Payment Modes</field>
        <field name="res_model">hds.payment.mode</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Payment Mode
            </p>
            <p>
                Configure the salary disbursement methods available in your organization
                (e.g. Bank Transfer, NEFT/RTGS, Cash, UPI). These modes appear on employee
                profiles and payslips.
            </p>
        </field>
    </record>

    <!-- Menu Item under Payroll Configuration -->
    <menuitem id="menu_hds_payment_mode"
              name="Payment Modes"
              action="action_hds_payment_mode"
              parent="hudson_payroll_base.menu_hr_payroll_configuration"
              sequence="85"/>
</odoo>
