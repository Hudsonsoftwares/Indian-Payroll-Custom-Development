<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.company form view to add Indian Statutory & TDS Configuration -->
    <record id="view_company_form_inherit_hds_in_payroll" model="ir.ui.view">
        <field name="name">res.company.form.inherit.hds.in.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Indian Statutory Payroll" name="hds_in_statutory_page">
                    <group>
                        <!-- TDS Section -->
                        <group string="Tax Deducted at Source (TDS)">
                            <field name="hds_in_tds_applicable"/>
                            <field name="hds_in_tan" placeholder="e.g. ABCD12345E" required="hds_in_tds_applicable"/>
                            <field name="hds_in_default_tax_regime" required="hds_in_tds_applicable"/>
                            <field name="hds_in_default_tax_year" placeholder="Select Default Tax Year"/>
                        </group>


                        <!-- Professional Tax Section -->
                        <group string="Professional Tax (PT)">
                            <field name="hds_in_enable_professional_tax"/>
                            <field name="hds_in_professional_tax_registration_no" placeholder="e.g. PTRC/MH/2026/00123" invisible="not hds_in_enable_professional_tax"/>
                        </group>
                    </group>
                    <group>
                        <!-- EPF & EPS Section -->
                        <group string="Employee Provident Fund (EPF)">
                            <field name="hds_in_epf_applicable"/>
                            <field name="hds_in_epf_employer_id" placeholder="e.g. MH/BAN/0012345/000" invisible="not hds_in_epf_applicable"/>
                            <field name="hds_in_eps_applicable"/>
                            <field name="hds_in_edli_applicable"/>
                            <field name="hds_in_edli_registration_number" invisible="not hds_in_edli_applicable"/>
                        </group>

                        <!-- ESIC Section -->
                        <group string="Employees' State Insurance (ESIC)">
                            <field name="hds_in_esic_applicable"/>
                            <field name="hds_in_esic_employer_code" placeholder="e.g. 31000123450000101" invisible="not hds_in_esic_applicable"/>
                            <field name="hds_in_esic_registration_no" placeholder="e.g. ESIC/MH/3100012" invisible="not hds_in_esic_applicable"/>
                            <field name="hds_in_esic_branch_office" placeholder="e.g. Sub-Regional Office Thane" invisible="not hds_in_esic_applicable"/>
                        </group>
                    </group>
                    <group>
                        <!-- LWF & Gratuity Section -->
                        <group string="Labour Welfare Fund (LWF)">
                            <field name="hds_in_enable_lwf"/>
                            <field name="hds_in_lwf_registration_no" placeholder="e.g. LWF/MH/2024/00123" invisible="not hds_in_enable_lwf"/>
                        </group>
                        <group string="Gratuity">
                            <field name="hds_in_enable_gratuity"/>
                            <field name="hds_in_gratuity_registration_no" placeholder="e.g. GR/MH/2024/00567" invisible="not hds_in_enable_gratuity"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
