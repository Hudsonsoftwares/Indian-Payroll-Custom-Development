<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View for Professional Tax State Slabs -->
    <record id="pt_state_slab_view_tree" model="ir.ui.view">
        <field name="name">pt.state.slab.view.list</field>
        <field name="model">pt.state.slab</field>
        <field name="arch" type="xml">
            <list string="Professional Tax State Slabs" multi_edit="1">
                <field name="state_id"/>
                <field name="periodicity" readonly="1"/>
                <field name="gender" optional="show"/>
                <field name="salary_from"/>
                <field name="salary_to"/>
                <field name="pt_amount"/>
                <field name="override_month" optional="hide"/>
                <field name="override_amount" optional="hide"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View for Professional Tax State Slabs -->
    <record id="pt_state_slab_view_form" model="ir.ui.view">
        <field name="name">pt.state.slab.view.form</field>
        <field name="model">pt.state.slab</field>
        <field name="arch" type="xml">
            <form string="Professional Tax State Slab">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="Automated Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="state_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="gender"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Salary Slab">
                            <field name="salary_from"/>
                            <field name="salary_to" placeholder="Leave blank for open-ended upper slab"/>
                            <field name="pt_amount"/>
                            <field name="periodicity" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Special Monthly Override">
                            <field name="override_month" placeholder="None (Standard Monthly)"/>
                            <field name="override_amount" placeholder="e.g. 300.00"/>
                        </group>
                    </group>
                    <group>
                        <group string="Validity">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Compliance">
                            <field name="notification_ref" placeholder="e.g. Maharashtra PT Act, 1975 (Revised 2024)"/>
                            <field name="special_rules" placeholder="e.g. Male slab; Rs.300 in Feb instead of Rs.200"/>
                            <field name="remarks" placeholder="Source notes, dataset references, or caveats..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Professional Tax State Slabs -->
    <record id="pt_state_slab_view_search" model="ir.ui.view">
        <field name="name">pt.state.slab.view.search</field>
        <field name="model">pt.state.slab</field>
        <field name="arch" type="xml">
            <search string="Search Professional Tax State Slabs">
                <field name="state_id"/>
                <field name="notification_ref"/>
                <field name="special_rules"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <filter string="Has Monthly Override" name="filter_override" domain="[('override_month', '!=', False)]"/>

                <separator/>
                <group>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Periodicity" name="group_by_periodicity" context="{'group_by': 'periodicity'}"/>
                    <filter string="Gender Criteria" name="group_by_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for Professional Tax State Slabs -->
    <record id="pt_state_slab_action" model="ir.actions.act_window">
        <field name="name">Professional Tax State Slabs</field>
        <field name="res_model">pt.state.slab</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pt_state_slab_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Professional Tax State Slab!
            </p>
            <p>
                Configure state-wise Professional Tax salary ranges, deduction amounts, periodicity, special monthly overrides, and validity periods.
            </p>
        </field>
    </record>

    <!-- Action Menu: Payroll -> Configuration -> Indian Statutory -> Professional Tax Slabs -->
    <menuitem id="menu_pt_state_slab"
              name="Professional Tax Slabs"
              parent="menu_hds_in_tds_configuration"
              action="pt_state_slab_action"
              sequence="50"/>
</odoo>
