<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company Record Rule for Enterprise Statutory Compliance Report -->
        <record id="hds_in_statutory_report_comp_rule" model="ir.rule">
            <field name="name">Statutory Report Multi-Company Rule</field>
            <field name="model_id" ref="model_hds_in_statutory_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
