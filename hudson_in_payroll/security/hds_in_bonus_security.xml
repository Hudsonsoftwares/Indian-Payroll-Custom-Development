<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rule for Bonus Document -->
        <record id="hds_in_bonus_comp_rule" model="ir.rule">
            <field name="name">Bonus Multi-Company Rule</field>
            <field name="model_id" ref="model_hds_in_bonus"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Rule for Bonus Document Line -->
        <record id="hds_in_bonus_line_comp_rule" model="ir.rule">
            <field name="name">Bonus Line Multi-Company Rule</field>
            <field name="model_id" ref="model_hds_in_bonus_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('bonus_id.company_id', '=', False), ('bonus_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
