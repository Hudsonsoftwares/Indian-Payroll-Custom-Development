<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_lwf_report_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.lwf.report.wizard.view.form</field>
        <field name="model">hds.lwf.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Labour Welfare Fund Report">
                <sheet>
                    <div class="oe_title">
                        <h2>Labour Welfare Fund Report</h2>
                    </div>
                    <group>
                        <group string="Reporting Period">
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group string="Filter Criteria">
                            <field name="payslip_state"/>
                            <field name="department_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button name="action_export_xlsx"
                            string="Export XLSX"
                            type="object"
                            class="btn-success"
                            icon="fa-file-excel-o"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hds_lwf_report_wizard" model="ir.actions.act_window">
        <field name="name">Labour Welfare Fund (LWF) Report</field>
        <field name="res_model">hds.lwf.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
