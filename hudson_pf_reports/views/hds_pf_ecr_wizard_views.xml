<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_pf_ecr_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.pf.ecr.wizard.view.form</field>
        <field name="model">hds.pf.ecr.wizard</field>
        <field name="arch" type="xml">
            <form string="EPF-ECR Report Wizard" class="o_hds_pf_ecr_form">
                <header>
                    <button name="action_generate_ecr"
                            string="Export XLSX File"
                            type="object"
                            class="btn-success"
                            icon="fa-file-excel-o"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Report Configuration">
                            <field name="year" required="1"/>
                            <field name="month" required="1"/>
                            <field name="report_type" required="1" widget="radio"/>
                            <field name="payslip_state"/>
                            <field name="company_id" groups="base.group_multi_company" required="1"/>
                        </group>
                        <group string="Summary Statistics" invisible="state == 'draft'">
                            <field name="record_count" readonly="1"/>
                            <field name="total_epf_wages" readonly="1"/>
                            <field name="total_epf_deduction" readonly="1"/>
                            <field name="total_epf_er_contribution" readonly="1"/>
                            <field name="total_eps_contribution" readonly="1"/>
                        </group>
                    </group>
                    <field name="xlsx_filename" invisible="1"/>
                    <field name="xlsx_file" invisible="1"/>
                    <field name="txt_filename" invisible="1"/>
                    <field name="txt_file" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hds_pf_ecr_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.pf.ecr.wizard.view.list</field>
        <field name="model">hds.pf.ecr.wizard</field>
        <field name="arch" type="xml">
            <list string="EPF-ECR Report Log">
                <field name="name"/>
                <field name="report_type" optional="show"/>
                <field name="year" optional="show"/>
                <field name="month" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="record_count" optional="show"/>
                <field name="total_epf_wages" optional="show"/>
                <field name="total_epf_deduction" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hds_pf_ecr_wizard" model="ir.actions.act_window">
        <field name="name">EPF-ECR Report</field>
        <field name="res_model">hds.pf.ecr.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
