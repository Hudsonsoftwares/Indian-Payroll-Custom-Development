<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly PF Summary -->
    <record id="hds_pf_monthly_summary_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.pf.monthly.summary.wizard.view.form</field>
        <field name="model">hds.pf.monthly.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly PF Summary Wizard">
                <header>
                    <button name="action_export_xlsx" string="Export XLSX File" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Year &amp; Scope">
                            <field name="year" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" required="1"/>
                        </group>
                    </group>
                    <group string="Generated Report File" invisible="state == 'draft'">
                        <field name="xlsx_filename" invisible="1"/>
                        <field name="xlsx_file" filename="xlsx_filename" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hds_pf_monthly_summary_wizard" model="ir.actions.act_window">
        <field name="name">Monthly PF Summary</field>
        <field name="res_model">hds.pf.monthly.summary.wizard</field>
        <field name="view_mode">form,list</field>
    </record>

