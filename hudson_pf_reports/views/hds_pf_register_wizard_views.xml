<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hds_pf_register_wizard_view_form" model="ir.ui.view">
        <field name="name">hds.pf.register.wizard.view.form</field>
        <field name="model">hds.pf.register.wizard</field>
        <field name="arch" type="xml">
            <form string="PF Register &amp; Employee Statement">
                <header>
                    <button name="action_export_xlsx"
                            string="Export XLSX"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_draft"
                            string="Back"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <!-- Draft Mode Top Title -->
                    <div class="oe_title" invisible="state != 'draft'">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Draft Mode Input Filters -->
                    <group string="Period &amp; Filters" invisible="state != 'draft'">
                        <group>
                            <field name="month" required="1"/>
                            <field name="year" required="1"/>
                            <field name="company_id" groups="base.group_multi_company" required="1"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="employee_id"/>
                        </group>
                    </group>

                    <!-- ============================================================== -->
                    <!-- CASE 1: Company PF Register Summary Aggregates (Not Employee) -->
                    <!-- ============================================================== -->
                    <div class="o_pf_register_wrapper mt-2" invisible="state == 'draft' or employee_id">
                        <div class="card mb-3 border-primary shadow-sm">
                            <div class="card-body bg-light py-3">
                                <h2 class="text-primary mb-1 fw-bold">Provident Fund Register</h2>
                                <div class="text-muted fs-6">
                                    <span>Payroll Period : <strong><field name="display_month_year" readonly="1"/></strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Company : <strong><field name="company_id" readonly="1"/></strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Generated On : <strong><field name="generated_on_date" readonly="1"/></strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Stat Summary Cards for Company Register -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-info text-white py-2">
                                <h6 class="mb-0 fw-bold"><i class="fa fa-tachometer me-2"/>Register Overview</h6>
                            </div>
                            <div class="card-body py-3">
                                <div class="row g-3">
                                    <div class="col-md-3 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-info">
                                            <div class="text-muted small fw-bold text-uppercase">Total Employees</div>
                                            <div class="fs-3 text-info fw-bold"><field name="record_count" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-primary">
                                            <div class="text-muted small fw-bold text-uppercase">Total PF Wages</div>
                                            <div class="fs-3 text-primary fw-bold"><field name="total_pf_wages" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-warning">
                                            <div class="text-muted small fw-bold text-uppercase">Total Employee EPF</div>
                                            <div class="fs-3 text-warning fw-bold"><field name="total_employee_epf" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-success">
                                            <div class="text-muted small fw-bold text-uppercase">Total Employer Cost</div>
                                            <div class="fs-3 text-success fw-bold"><field name="total_employer_cost" readonly="1"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <group string="Detailed Breakdown Summary">
                            <group>
                                <field name="total_employer_epf" readonly="1"/>
                                <field name="total_employer_eps" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_edli" readonly="1"/>
                                <field name="total_employer_cost" readonly="1"/>
                            </group>
                        </group>
                    </div>

                    <!-- ============================================================== -->
                    <!-- CASE 2: Redesigned Statutory Employee PF Statement            -->
                    <!-- ============================================================== -->
                    <div class="o_pf_statement_wrapper mt-2" invisible="state == 'draft' or not employee_id">
                        
                        <!-- Single Clean Page Header & Subtitle -->
                        <div class="card mb-3 border-primary shadow-sm">
                            <div class="card-body bg-light py-3">
                                <h2 class="text-primary mb-1 fw-bold">Employee PF Statement</h2>
                                <h4 class="fw-bold text-dark mb-1">
                                    <field name="emp_summary_name" readonly="1"/>
                                </h4>
                                <div class="text-muted fs-6">
                                    <span>Payroll Period : <strong><field name="display_month_year" readonly="1"/></strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Company : <strong><field name="company_id" readonly="1"/></strong></span>
                                    <span class="mx-2">•</span>
                                    <span>Generated On : <strong><field name="generated_on_date" readonly="1"/></strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 1: Payroll Information Card -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-primary text-white py-2">
                                <h6 class="mb-0 fw-bold"><i class="fa fa-calendar me-2"/>Payroll Information</h6>
                            </div>
                            <div class="card-body py-3">
                                <div class="row">
                                    <div class="col-md-3 col-sm-6 mb-2">
                                        <div class="text-muted small fw-bold">Payroll Month</div>
                                        <div class="fs-6 text-dark fw-bold"><field name="month" readonly="1"/></div>
                                    </div>
                                    <div class="col-md-3 col-sm-6 mb-2">
                                        <div class="text-muted small fw-bold">Payroll Year</div>
                                        <div class="fs-6 text-dark fw-bold"><field name="year" readonly="1"/></div>
                                    </div>
                                    <div class="col-md-3 col-sm-6 mb-2">
                                        <div class="text-muted small fw-bold">Company</div>
                                        <div class="fs-6 text-dark fw-bold"><field name="company_id" readonly="1"/></div>
                                    </div>
                                    <div class="col-md-3 col-sm-6 mb-2">
                                        <div class="text-muted small fw-bold">Department</div>
                                        <div class="fs-6 text-dark fw-bold"><field name="emp_summary_department" readonly="1"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Employee Information Card (2-Column) -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-secondary text-white py-2">
                                <h6 class="mb-0 fw-bold"><i class="fa fa-id-card me-2"/>Employee Information</h6>
                            </div>
                            <div class="card-body py-3">
                                <group col="2">
                                    <group>
                                        <field name="emp_summary_name" string="Employee Name" readonly="1"/>
                                        <field name="emp_summary_code" string="Employee ID" readonly="1"/>
                                        <field name="emp_summary_designation" string="Designation" readonly="1"/>
                                        <field name="emp_summary_department" string="Department" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="emp_summary_uan" string="UAN Number" readonly="1"/>
                                        <field name="emp_summary_pf_applicable" string="PF Applicable" readonly="1"/>
                                        <field name="emp_summary_basis" string="Contribution Basis" readonly="1"/>
                                    </group>
                                </group>
                            </div>
                        </div>

                        <!-- Section 3: PF Contribution Summary (Stat Cards) -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-info text-white py-2">
                                <h6 class="mb-0 fw-bold"><i class="fa fa-tachometer me-2"/>PF Contribution Summary</h6>
                            </div>
                            <div class="card-body py-3">
                                <div class="row g-3">
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-info">
                                            <div class="text-muted small fw-bold text-uppercase">PF Wage</div>
                                            <div class="fs-3 text-info fw-bold"><field name="emp_summary_pf_wage" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-warning">
                                            <div class="text-muted small fw-bold text-uppercase">Employee EPF</div>
                                            <div class="fs-3 text-warning fw-bold"><field name="emp_summary_ee_epf" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-primary">
                                            <div class="text-muted small fw-bold text-uppercase">Employer EPF Share</div>
                                            <div class="fs-3 text-primary fw-bold"><field name="emp_summary_er_epf" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-purple">
                                            <div class="text-muted small fw-bold text-uppercase">Employer EPS</div>
                                            <div class="fs-3 text-secondary fw-bold"><field name="emp_summary_er_eps" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-dark">
                                            <div class="text-muted small fw-bold text-uppercase">EDLI &amp; Admin Charges</div>
                                            <div class="fs-3 text-dark fw-bold"><field name="emp_summary_edli_admin" readonly="1"/></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="p-3 border rounded text-center bg-light shadow-sm border-success">
                                            <div class="text-muted small fw-bold text-uppercase">Employer Total Statutory Cost</div>
                                            <div class="fs-3 text-success fw-bold"><field name="emp_summary_total_cost" readonly="1"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 4: Contribution Breakdown Table -->
                        <div class="card mb-3 shadow-sm">
                            <div class="card-header bg-dark text-white py-2">
                                <h6 class="mb-0 fw-bold"><i class="fa fa-table me-2"/>Contribution Breakdown</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Contribution Type</th>
                                                <th class="text-end pe-3">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="ps-3 fw-bold">PF Wage</td>
                                                <td class="text-end pe-3 fw-bold"><field name="emp_summary_pf_wage" readonly="1"/></td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3">Employee EPF</td>
                                                <td class="text-end pe-3"><field name="emp_summary_ee_epf" readonly="1"/></td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3">Employer EPF Share</td>
                                                <td class="text-end pe-3"><field name="emp_summary_er_epf" readonly="1"/></td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3">Employer EPS</td>
                                                <td class="text-end pe-3"><field name="emp_summary_er_eps" readonly="1"/></td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3">EDLI &amp; Admin Charges</td>
                                                <td class="text-end pe-3"><field name="emp_summary_edli_admin" readonly="1"/></td>
                                            </tr>
                                            <tr class="table-success">
                                                <td class="ps-3 fw-bold">Employer Total Statutory Cost</td>
                                                <td class="text-end pe-3 fw-bold fs-6"><field name="emp_summary_total_cost" readonly="1"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 5: Generated Files -->
                    <div class="card mb-3 shadow-sm" invisible="state == 'draft'">
                        <div class="card-header bg-light py-2">
                            <h6 class="mb-0 fw-bold text-dark"><i class="fa fa-file-excel-o me-2"/>Generated Files</h6>
                        </div>
                        <div class="card-body">
                            <group col="2">
                                <group>
                                    <field name="xlsx_filename" invisible="1"/>
                                    <field name="xlsx_file" filename="xlsx_filename" readonly="1" string="Generated Excel Report"/>
                                </group>
                            </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hds_pf_register_wizard_view_list" model="ir.ui.view">
        <field name="name">hds.pf.register.wizard.view.list</field>
        <field name="model">hds.pf.register.wizard</field>
        <field name="arch" type="xml">
            <list string="PF Register / Statement History Log">
                <field name="name"/>
                <field name="month" optional="show"/>
                <field name="year" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="record_count" optional="show"/>
                <field name="total_pf_wages" optional="show"/>
                <field name="total_employee_epf" optional="show"/>
                <field name="total_employer_cost" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hds_pf_register_wizard" model="ir.actions.act_window">
        <field name="name">PF Register</field>
        <field name="res_model">hds.pf.register.wizard</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
    </record>
</odoo>
