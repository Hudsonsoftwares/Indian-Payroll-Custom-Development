<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_hudson_employee_info" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hudson.employee.info</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- 1. PERSONAL INFORMATION -->
            <xpath expr="//field[@name='birthday']" position="after">
                <field name="show_birthday_to_employees"/>
                <field name="is_disabled"/>
                <field name="payslip_lang_id" options="{'no_create': True}"/>
            </xpath>

            <!-- 2. CITIZENSHIP -->
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="is_non_resident"/>
            </xpath>

            <!-- 3. VISA & WORK PERMIT -->
            <xpath expr="//field[@name='permit_no']" position="after">
                <field name="work_permit_expiry_date" string="Expires On"/>
            </xpath>

            <!-- 4. FAMILY -->
            <xpath expr="//field[@name='spouse_complete_name']" position="after">
                <field name="spouse_legal_name"/>
                <field name="spouse_birthdate"/>
            </xpath>

            <!-- 5. DOCUMENTS -->
            <xpath expr="//page[@name='personal_information']/group" position="inside">
                <group string="Employee Documents" name="hudson_employee_docs">
                    <field name="sim_card_copy_filename" invisible="1"/>
                    <field name="sim_card_copy" filename="sim_card_copy_filename" widget="binary" string="SIM Card Copy"/>
                    <field name="internet_subscription_invoice_filename" invisible="1"/>
                    <field name="internet_subscription_invoice" filename="internet_subscription_invoice_filename" widget="binary" string="Internet Subscription Invoice"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
