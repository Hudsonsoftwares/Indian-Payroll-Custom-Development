<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Final Settlement Numbers (FSET/YYYY/00001) -->
        <record id="seq_final_settlement" model="ir.sequence">
            <field name="name">Final Settlement Sequence</field>
            <field name="code">final.settlement</field>
            <field name="prefix">FSET/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
