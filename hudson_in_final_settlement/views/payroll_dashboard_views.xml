<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View Inheritance for Payroll Dashboard in Final Settlement Module -->
    <record id="hds_payroll_dashboard_view_form_inherit_final_settlement" model="ir.ui.view">
        <field name="name">hds.payroll.dashboard.form.inherit.final.settlement</field>
        <field name="model">hds.payroll.dashboard</field>
        <field name="inherit_id" ref="hudson_in_payroll.hds_payroll_dashboard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_final_settlements_due" string="Final Settlements Due →" type="object" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
    <!-- Window Action for Clickable Final Settlements Due Dashboard Card -->
    <record id="action_dashboard_final_settlements_due" model="ir.actions.act_window">
        <field name="name">Final Settlements Due</field>
        <field name="res_model">final.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>
</odoo>
